{
  "name": "video-downloader-pro",
  "version": "1.0.27",
  "description": "Professional batch video downloader with modern UI",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:clean": "powershell -ExecutionPolicy Bypass -File ./scripts/dev.ps1 -Clean",
    "dev:check": "powershell -ExecutionPolicy Bypass -File ./scripts/dev.ps1 -Check",
    "start": "./scripts/quick-start.bat",
    "build": "pnpm sidecars:check && tauri build",
    "build:local": "pnpm sidecars:check -- --allow-placeholders && tauri build --features local-logging",
    "build:prod": "pnpm sidecars:check && tauri build",
    "vite": "vite",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:integration": "vitest --config vitest.config.integration.ts",
    "test:integration:ui": "vitest --config vitest.config.integration.ts --ui",
    "test:e2e": "vitest run --config vitest.config.integration.ts",
    "test:tauri-smoke": "node scripts/tauri-mcp-smoke.mjs",
    "test:all": "pnpm lint && pnpm type-check && pnpm exec vitest run && pnpm exec vitest run --config vitest.config.integration.ts && cargo fmt --manifest-path src-tauri/Cargo.toml --all --check && cargo test --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "sidecars:check": "node scripts/validate-sidecars.mjs",
    "sidecars:check:all": "node scripts/validate-sidecars.mjs --all",
    "sidecars:check:local": "node scripts/validate-sidecars.mjs --allow-placeholders",
    "sidecars:prepare": "node scripts/prepare-sidecars.mjs",
    "risk:gitnexus": "node scripts/check-gitnexus-risk.mjs --scope all",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "audit:js": "pnpm audit --audit-level moderate",
    "audit:rust": "./scripts/audit-rust.sh",
    "audit:deps": "pnpm audit --audit-level moderate && ./scripts/audit-rust.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.4.1",
    "react-i18next": "^15.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/cli": "^2.11.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "eslint": "^9.39.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "ffmpeg-static": "^5.2.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.7.2",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12",
    "ws": "^8.21.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "@humanfs/node": "^0.16.8",
      "baseline-browser-mapping": "^2.11.0",
      "brace-expansion@^1.0.0": "^1.1.21",
      "brace-expansion@>=3.0.0": "^5.0.12",
      "browserslist": "^4.28.7",
      "fflate@^0.8.0": "^0.8.3",
      "form-data": "^4.0.6",
      "js-yaml": "^4.3.2",
      "minimatch@>=7.0.0": "^11.0.1",
      "nanoid@^3.3.11": "^3.3.18",
      "postcss": "^8.5.23",
      "source-map-js": "^1.2.2"
    }
  },
  "packageManager": "pnpm@9.15.0"
}
